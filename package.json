{
  "name": "amhfxmotionrender",
  "private": true,
  "version": "3.9.4",
  "type": "module",
  "scripts": {
    "serve": "python scripts/serve.py",
    "snap": "node scripts/snap.mjs",
    "export:frames": "node scripts/export-frames.mjs",
    "export:mp4": "node scripts/export-mp4.mjs",
    "export:mp4:final": "QUALITY=final node scripts/export-mp4.mjs",
    "render:ffmpeg": "node scripts/export-mp4.mjs",
    "render:ffmpeg:final": "QUALITY=final node scripts/export-mp4.mjs",
    "render:ffmpeg:files": "FRAME_TRANSPORT=files node scripts/export-mp4.mjs",
    "render:production": "node scripts/render-production.mjs",
    "render:anomali": "node projects/anomali-shorts/render-all.mjs",
    "verify:anomali": "node projects/anomali-shorts/verify-delivery.mjs",
    "render:anomalia": "node projects/anomali-shorts-v2/render-all.mjs",
    "verify:anomalia": "node projects/anomali-shorts-v2/verify-delivery.mjs",
    "render:anomalia-next": "node projects/anomalia-shorts-11-20/render-all.mjs",
    "verify:anomalia-next": "node projects/anomalia-shorts-11-20/verify-delivery.mjs",
    "check:skill": "node scripts/check-skill.mjs",
    "check:creative": "node scripts/check-creative-gates.mjs",
    "verify:final": "node scripts/finalize-verification.mjs",
    "check": "npm run check:version && npm run check:skill && node --check scripts/check-skill.mjs && node --check scripts/check-creative-gates.mjs && node --check scripts/finalize-verification.mjs && node --check scripts/render-production.mjs && node --check scripts/export-mp4.mjs && node --check scripts/export-frames.mjs && node --check scripts/snap.mjs && node --check runtime/index.js && node --check runtime/motion-utils.js && node --check runtime/camera-rig.js && node --check runtime/explainer-helpers.js && node --check runtime/three-scene.js && node --check runtime/audio-runtime.js",
    "check:version": "node scripts/check-version-sync.mjs",
    "render:anomalia-legends": "node projects/anomalia-shorts-21-30/render-all.mjs",
    "verify:anomalia-legends": "node projects/anomalia-shorts-21-30/verify-delivery.mjs",
    "render:anomalia-remake": "node projects/anomalia-remake-07-10/render-all.mjs",
    "verify:anomalia-remake": "node projects/anomalia-remake-07-10/verify-delivery.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "puppeteer": "^25.11.0"
  },
  "description": "Browser motion renderer with deterministic Chromium-to-FFmpeg frame streaming, creative verification gates, and H.264/AAC encoding.",
  "repository": {
    "type": "git",
    "url": "https://github.com/glitchnormal26-hash/AMHFXMOTIONRENDER.git"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@napi-rs/canvas": "^1.0.11",
    "@sparticuz/chromium": "^153.0.0"
  }
}
