# Optional exporter overrides
QUALITY=fast
OUT_VIDEO=output/final.mp4
# Target video bitrate (replaces CRF when set). Accepts 6000, 6000k, 6M, or 6000000.
# BITRATE=6000k
# MAXRATE=6000k
# BUFSIZE=12000k
# FPS=30 WIDTH=1920 HEIGHT=1080 PRESET=medium
# Absolute tool overrides for hosts where these are not on PATH:
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFPROBE_PATH=/usr/local/bin/ffprobe
# CHROME_PATH=/usr/local/bin/chrome-headless-shell
# NO_SANDBOX=1
# OFFLINE_ASSETS=/path/to/offline-map.json
#   JSON map used on hosts where public CDNs are unreachable, e.g.
#   { "https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js": "/abs/node_modules/gsap/dist/gsap.min.js",
#     "/npm/three@0.161.0/": "/abs/node_modules/three/" }
#   A key ending in "/" maps the URL suffix onto a local directory; other keys map
#   an exact URL to a local file. examples/jsm files get bare "three" specifiers
#   rewritten to a relative path, matching what jsdelivr serves.
# REQUIRE_VO=1
# AUDIO=audio/final-mix.wav
# VOICEOVER=audio/voiceover.wav
# SFX=audio/sfx-mix.wav
# AMBIENCE=audio/ambience.wav
