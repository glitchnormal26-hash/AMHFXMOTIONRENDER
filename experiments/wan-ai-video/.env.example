# ---- Wan / Alibaba Model Studio (DashScope) ----
# Ambil API key di: https://modelstudio.console.alibabacloud.com/  (region Singapore = intl)
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Endpoint. Singapore/intl (default):
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
# Beijing:
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# Model default
WAN_MODEL=wan2.2-t2v-plus

# ---- App ----
PORT=3000
# dashscope = panggil API Wan asli | mock = demo lokal tanpa API key
WAN_PROVIDER=dashscope
# Set 0 kalau tidak mau video otomatis diunduh ke data/videos (URL Wan hanya valid 24 jam)
DOWNLOAD_VIDEOS=1
POLL_INTERVAL_MS=5000
# DATA_DIR=./data
